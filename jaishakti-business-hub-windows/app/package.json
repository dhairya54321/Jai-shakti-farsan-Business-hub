{
  "name": "jaishakti-business-hub",
  "version": "1.0.0",
  "description": "Jai Shakti Farsan Mart - Business Management System (Phase 1: Daily Expenses)",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite --config client/vite.config.js",
    "dev": "node server/scripts/dev.js",
    "build:client": "vite build --config client/vite.config.js",
    "build": "npm run build:client",
    "start": "node server/index.js",
    "test": "DB_PATH=data/test_jaishakti.sqlite node tests/setup.js && DB_PATH=data/test_jaishakti.sqlite node --test --test-concurrency=1 tests/*.test.js",
    "migrate": "node server/db/migrate.js",
    "seed": "node server/db/seed.js",
    "backup": "node server/scripts/backup-cli.js",
    "restore": "node server/scripts/restore-cli.js",
    "health": "node server/scripts/health-cli.js"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "archiver": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.475.0",
    "multer": "^1.4.5-lts.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.17",
    "vite": "^6.1.0"
  }
}
