# Jai Shakti Business Hub - Windows Shop PC Configuration
PORT=3000
NODE_ENV=production

# Relative storage paths (isolated outside app/)
DATA_DIR=./data
UPLOADS_DIR=./uploads
BACKUP_DIR=./backups
LOG_DIR=./logs
DB_PATH=./data/jaishakti.sqlite

# Security & Business Settings
JWT_SECRET=change-this-to-a-secure-random-secret-key-for-shop-pc
JWT_EXPIRES_IN=7d
BUSINESS_TIMEZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR
